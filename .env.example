# AI provider: mock (default, offline) | watsonx | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
AI_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_VAULT_KEY=
# At least 32 random characters; signs session cookies
SESSION_SECRET=

# Used once by `npm run seed` to create the first IT officer (forced password change on first login)
INITIAL_IT_OFFICER_EMAIL=
INITIAL_IT_OFFICER_PASSWORD=
