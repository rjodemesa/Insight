{
  "name": "insight",
  "version": "0.1.0",
  "private": true,
  "description": "P&G Philippines Consumer Insight Platform",
  "scripts": {
    "predev": "node scripts/setup-env.mjs && npm run seed --silent",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "tsx scripts/make-fixture.ts",
    "import": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import.ts",
    "reprocess": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reprocess.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.12"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "postcss": "^8.5.29",
    "uuid": "^11.1.1"
  }
}
